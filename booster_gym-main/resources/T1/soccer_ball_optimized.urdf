<?xml version="1.0" encoding="utf-8"?>
<robot name="soccer_ball">
  <link name="soccer_ball">
    <inertial>
      <mass value="0.43"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    
    <!-- 主球体 -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <material name="ball_texture">
        <color rgba="1.0 0.3 0.1 1.0"/>  <!-- 橙红色，更容易识别 -->
      </material>
    </visual>
    
    <!-- 简化的标记 - 只保留一个用于旋转观察 -->
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.12"/>  <!-- 改为圆柱形，更平滑 -->
      </geometry>
      <material name="black_mark">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
    
    <!-- 碰撞检测 - 只用球体，避免标记干扰 -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.11"/>
      </geometry>
      <contact>
        <restitution value="0.8"/>
        <friction value="0.7"/>
      </contact>
    </collision>
  </link>
</robot> 